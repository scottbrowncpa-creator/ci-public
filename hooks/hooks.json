{
  "description": "Re-read rule (reminds Claude to re-read files from disk) and protect-data check (refuses files with student or bank numbers, warns on SSNs).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CI_PUBLIC_REREAD\" = \"off\" ] || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/reread.txt\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/ci-protect-data/scripts/protect_data_hook.py\" prompt || python \"${CLAUDE_PLUGIN_ROOT}/skills/ci-protect-data/scripts/protect_data_hook.py\" prompt",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CI_PUBLIC_REREAD\" = \"off\" ] || cat \"${CLAUDE_PLUGIN_ROOT}/hooks/reread.txt\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|PowerShell|mcp__PDF_Tools__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/ci-protect-data/scripts/protect_data_hook.py\" pre || python \"${CLAUDE_PLUGIN_ROOT}/skills/ci-protect-data/scripts/protect_data_hook.py\" pre",
            "timeout": 60,
            "statusMessage": "protect-data check"
          }
        ]
      }
    ]
  }
}
